# image panel secret (server-only, never commit)
panel/secret.php

# Simhastha news section config (DB creds) — server copy lives above the webroot
news-config.php

# BNA uploads hero cards into this dir at runtime (server-only, kept by the
# additive images rsync pass). Keep the directory, never the files.
public/images/news/*
!public/images/news/.gitkeep

# Local-only router that stands in for the .htaccess rewrites so the PHP-SSR news
# section can be exercised with `php -S 127.0.0.1:8099 -t public news-router.local.php`.
news-router.local.php
