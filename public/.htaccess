# UjjainTemple.com — Hostinger origin config
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www → root (or invert if you prefer www)
RewriteCond %{HTTP_HOST} ^www\.ujjaintemple\.com [NC]
RewriteRule ^(.*)$ https://ujjaintemple.com/$1 [L,R=301]

# ── Removed content → closest live page (SEO 301) ──
RewriteRule ^(en/|hi/)?puja-in-ujjain/mahakal-lok-corridor/?$ /mandirs/mahakal-lok/ [L,R=301]
RewriteRule ^(en/|hi/)?puja-in-ujjain/mahakaleshwar-bhasma-aarti-booking/?$ /mandirs/mahakaleshwar/ [L,R=301]
# Simhastha sub-pages: the 2026-07-06 consolidation 301'd every sub-page to the landing.
# 2026-08-06 — five were restored to rebuild the topical cluster for 'simhastha 2028'
# (a single page cannot outrank purpose-built Simhastha sites). Those five must serve
# 200, so they are excluded here; every other sub-page still folds into the landing.
# 2026-08-12 — five commercial pages added (accommodation, tour-package, transport,
# from-indore-bhopal, budget): these carry the "simhastha 2028 + <intent>" long tail
# and terminate in the hotel/cab/tour money pages.
# 2026-09-06 — simhastha-2028-preparations added (city-wide readiness: roads, airport,
# ghats, water, temple restoration, crowd-management command centre).
# Keep this list in sync with src/content/simhastha/*.json — a slug missing here is
# built and sitemapped but 301s to the landing, so the page can never rank.
RewriteCond %{REQUEST_URI} !^/(en/|hi/)?simhastha-2028/(akhada-traditions-ujjain|history-of-simhastha-ujjain|sadhus-naga-babas-simhastha|snan-ghats-ujjain|kalpvas-guide|simhastha-2028-accommodation|simhastha-2028-tour-package|simhastha-2028-transport-guide|simhastha-2028-from-indore-bhopal|simhastha-2028-budget-guide|simhastha-2028-preparations)/?$
RewriteRule ^(en/|hi/)?simhastha-2028/[^/]+/?$ /simhastha-2028/ [L,R=301]

# ── Locale migration (2026-07): English is now the default at root; Hindi moved to /hi/ ──
# Old English URLs (/en/...) permanently redirect to the new root-level English pages
RewriteRule ^en/(.*)$ /$1 [L,R=301]
RewriteRule ^en/?$ / [R=301,L]

# ── Simhastha news API (BNA tenant endpoints) ──
# 🔴 /api/upload has no extension, so the trailing-slash rule below would 301 it —
# and a 301 on POST loses the multipart body. This MUST stay above that rule.
# The path itself is hardcoded in BNA (card_localizer.php), so it cannot move.
RewriteRule ^api/upload/?$ /api/upload.php [L,QSA]

# Trailing slash for directory-style URLs (matches SSG output)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(html|css|js|woff2|webp|jpg|png|svg|xml|txt|json|webmanifest|pdf|ico|php)$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# ── Simhastha 2028 news section (PHP-SSR, /news/index.php) ──
# Deliberately NOT under /simhastha-2028/ — the blanket 301 above folds every
# sub-path there into the landing, so an article would 301 away and never rank.
# "simhastha-2028-news/" does not match "simhastha-2028/" so this path is safe.
# Slugs are ASCII-only by construction (news/lib/slug.php) — keep the two in step.
RewriteRule ^hi/simhastha-2028-news/feed\.xml$          /news/index.php?view=feed [L]
RewriteRule ^hi/simhastha-2028-news/news-sitemap\.xml$  /news/index.php?view=sitemap [L]
RewriteRule ^hi/simhastha-2028-news/page/([0-9]{1,4})/?$ /news/index.php?view=list&p=$1 [L]
RewriteRule ^hi/simhastha-2028-news/?$                   /news/index.php?view=list [L]
RewriteRule ^hi/simhastha-2028-news/([A-Za-z0-9_-]+)/?$  /news/index.php?view=article&slug=$1 [L]

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Brotli / gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Block CSV leak
<Files "leads.csv">
  Order allow,deny
  Deny from all
</Files>
<Files "newsletter.csv">
  Order allow,deny
  Deny from all
</Files>

ErrorDocument 404 /404.html
